# ---------------------------------------------------------------------------
# api-stiker environment configuration
# Copy to `.env` and fill in real values. Never commit `.env`.
# Validated at boot (Zod). Missing required values fail fast.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=8080

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/api_stiker?schema=public

# Redis (cache / rate-limit / BullMQ)
REDIS_URL=redis://localhost:6379

# Auth (min 32 bytes each)
JWT_SECRET=change-me-to-a-32-byte-min-secret-value
JWT_REFRESH_SECRET=change-me-to-another-32-byte-secret-value
BCRYPT_ROUNDS=12

# Cloudinary (sticker assets)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase Admin SDK (FCM push)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Local/dev: when true, FCM dispatch is simulated (no network) instead of failing
# because the FIREBASE_* credentials above are unset. Keep false in production.
FCM_DRY_RUN=false

# Error tracking (Sentry). Leave SENTRY_DSN empty to disable reporting entirely.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
# 0 disables performance tracing; 0.1 = sample 10% of transactions.
SENTRY_TRACES_SAMPLE_RATE=0
